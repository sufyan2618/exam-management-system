# =============================================================================
# Root env for `docker compose` (copy to `.env` in the repo root)
#   cp .env.example .env
#   docker compose up -d --build
# =============================================================================

NODE_ENV=production
SITE_HOST=98.92.115.34

# Public URL of the app as seen by browsers (nginx). Used for CORS, cookies, verify links.
CLIENT_URL=https://98.92.115.34
CORS_ORIGINS=https://98.92.115.34
PUBLIC_VERIFY_BASE_URL=https://98.92.115.34/verify

# ---- MongoDB (compose service) ------------------------------------------------
MONGO_ROOT_USER=verity_root
MONGO_ROOT_PASSWORD=change-me-long-random-root-password
MONGO_APP_USER=verity_app
MONGO_APP_PASSWORD=change-me-long-random-app-password
MONGO_DB=exam
MONGO_URI=mongodb://${MONGO_APP_USER}:${MONGO_APP_PASSWORD}@mongodb:27017/${MONGO_DB}?authSource=${MONGO_DB}&replicaSet=rs0&directConnection=true

# ---- Redis (wired automatically inside compose) -------------------------------
# REDIS_URL is set by docker-compose to redis://redis:6379 — do not override unless needed.

# ---- Auth / security (REQUIRED — use long random values) ----------------------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
REPORT_HMAC_SECRET=change-me-report-hmac-secret-16+

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
COOKIE_SECURE=true
# COOKIE_DOMAIN=

# ---- App ----------------------------------------------------------------------
INSTITUTION_NAME=Verity Secure Examination
GRACE_SECONDS=5
MAX_UPLOAD_MB=5
LOG_LEVEL=info
ALLOW_DEMO_SEED=false
# Demo reset credentials are only used by the one-off seed profile. Change these before a public demo.
DEMO_ADMIN_PASSWORD=ShowcaseAdmin#2026!
DEMO_EXAMINER_PASSWORD=ShowcaseExaminer#2026!
DEMO_CANDIDATE_PASSWORD=ShowcaseCandidate#2026!

DISPUTE_SLA_HOURS=72
DISPUTE_COUNTERSIGN_MARKS=2

RATE_LIMIT_IP_PER_MIN=3000
RATE_LIMIT_USER_PER_MIN=300
RATE_LIMIT_AUTOSAVE_PER_MIN=120

# ---- Email (optional — leave blank / omit to skip outbound mail) --------------
# EMAIL_FROM=noreply@example.com
# BREVO_API_KEY=

# ---- Metrics (optional) -------------------------------------------------------
# METRICS_TOKEN=
