# =============================================================================
# Root env for `docker compose` (copy to `.env` in the repo root)
#   cp .env.example .env
#   docker compose up --build
# =============================================================================

NODE_ENV=production
HTTP_PORT=80

# Public URL of the app as seen by browsers (nginx). Used for CORS, cookies, verify links.
CLIENT_URL=http://localhost
# Optional comma-separated extras (leave blank to use CLIENT_URL only)
# CORS_ORIGINS=http://localhost,http://127.0.0.1

# ---- MongoDB (compose service) ------------------------------------------------
MONGO_USER=exam
MONGO_PASSWORD=change-me-strong-mongo-password
MONGO_DB=exam

# ---- Redis (wired automatically inside compose) -------------------------------
# REDIS_URL is set by docker-compose to redis://redis:6379 — do not override unless needed.

# ---- Auth / security (REQUIRED — use long random values) ----------------------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
REPORT_HMAC_SECRET=change-me-report-hmac-secret-16+

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# ---- App ----------------------------------------------------------------------
INSTITUTION_NAME=Secure Exam Platform
PUBLIC_VERIFY_BASE_URL=http://localhost/verify
GRACE_SECONDS=5
MAX_UPLOAD_MB=5
LOG_LEVEL=info
ALLOW_DEMO_SEED=false

DISPUTE_SLA_HOURS=72
DISPUTE_COUNTERSIGN_MARKS=2

RATE_LIMIT_IP_PER_MIN=3000
RATE_LIMIT_USER_PER_MIN=300
RATE_LIMIT_AUTOSAVE_PER_MIN=120

# ---- Email (optional — leave blank / omit to skip outbound mail) --------------
# EMAIL_FROM=noreply@example.com
# BREVO_API_KEY=

# ---- Metrics (optional) -------------------------------------------------------
# METRICS_TOKEN=
